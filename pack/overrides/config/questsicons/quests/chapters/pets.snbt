		{
			id: "7EE114252FBDA389"
			title: "Pets in Hiding"
			icon: "questsicons:icon_map"
			x: 4.5d
			y: 0.0d
			shape: "diamond"
			dependencies: ["56EDC7CC65844061"]
			description: [
				"&7Pets live in structures, but not in every one: each structure rolls once whether a pet lives there. Wild pets stay near their home and never despawn, so look inside and all around the building."
				"&7In Dreamcraft they also live in the look-alikes of these structures from other mods, like the pyramids, witch huts, mineshafts and mansions of Repurposed Structures."
				"&7Hold a Tamacraft Heart and wild pets come closer. The cute ones run away when hit; the Ember Pup, Sculk Wisp and Mimic bite back."
				""
				"&7Around this quest are the ten pets. Spot each one in the wild."
			]
			tasks: [ ]
			rewards: [
				{ id: "FC058D8BDFA7D955", type: "xp", xp: 50 }
			]
		}
