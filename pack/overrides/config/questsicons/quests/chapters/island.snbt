		{
			id: "A07EAE393771F3E7"
			title: "Sail and Mast"
			icon: "raft:sail"
			x: 1.8d
			y: 0.0d
			dependencies: ["5A842BF26F504A36"]
			description: [
				"&7For a raft you built yourself (see &bYour Own Raft&7 in the Endless Sea): a &eMast&7 is a pole you stack as high as you like. Set &eSails&7 next to it, side by side and on top of each other: they join into one big sheet, and every block of sail adds wind power."
				"&7Use a sail with an empty hand to furl it - the canvas rolls up under the yard and the raft no longer catches the wind. Use it again to set it."
			]
			tasks: [
				{
					id: "E995F94D24B1424C"
					type: "item"
					count: 4
					item: "raft:mast"
				}
				{
					id: "E995FA4D24B143FF"
					type: "item"
					count: 4
					item: "raft:sail"
