		}
		{
			id: "ED64B300AA8DF243"
			title: "Anchor Winch"
			x: 3.6d
			y: 0.0d
			dependencies: ["A07EAE393771F3E7"]
			description: [
				"&7Set an &eAnchor Winch&7 on the deck edge, anchor over the side. Use it to drop the anchor: a sailing raft stops and holds its position, even when the helmsman pushes on. Use it again to raise it and sail on."
				"&7To moor, use the wheel while you steer (or sneak and use it): the raft becomes blocks again."
			]
			tasks: [
				{ id: "2A3D8CCF877F7BDF", type: "item", item: "raft:anchor_winch" }
			]
			rewards: [
