			]
		}
		{
			id: "AC556A4B8EE5C382"
			title: "Make Yourself at Home"
			icon: "raft:palm_bench"
			x: 1.8d
			y: -1.8d
			dependencies: ["5A842BF26F504A36"]
			description: [
				"&7Sit on any seat or cushion, or lie in a hammock or bed: after 3 seconds you are &eRested&7. You heal half a heart every 4 seconds and get hungry 25% slower."
				"&7Rested lasts 2 minutes plus 1 minute per comfort point. Every kind of cozy thing within 6 blocks adds one: seats, tables, lights, fires, rugs, plants, shade, music, storage, wall decor and a view of the water. The old decorations count too."
			]
			tasks: [
				{ id: "C102D00A00D8079E", type: "item", item: "raft:palm_bench" }
				{ id: "C102D10A00D80951", type: "item", item: "raft:hurricane_lantern" }
